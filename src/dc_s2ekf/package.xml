<?xml version="1.0"?>
<package format="2">
  <name>dc_s2ekf</name>
  <version>0.0.1</version>
  <description>DC-S2EKF filtering for delayed visual bearing and bbox topics.</description>

  <maintainer email="lincolnliu@todo.todo">lincolnliu</maintainer>
  <license>TODO</license>

