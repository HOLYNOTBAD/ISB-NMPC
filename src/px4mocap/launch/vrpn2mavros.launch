<launch>
  <arg name="mocap_unit" default="m" /> <!-- m or mm -->
  <arg name="zero_position_on_first_pose" default="true" />
  <arg name="position_offset_x" default="0.0" />
  <arg name="position_offset_y" default="0.0" />
  <arg name="position_offset_z" default="0.0" />
  <arg name="max_abs_position_m" default="900.0" />
  <arg name="local_origin_topic" default="/local_frame/origin" />
  <!--和mocap中的刚体名称相同-->
  <arg name="marker_name" default="uav1" />
  <!--和wifi的IP相同-->
  <arg name="vrpn_server" default="127.0.0.1" />

  <node pkg="px4mocap" type="px4mocap_node" name="px4mocap_node" output="screen">
    <remap from="rigidpose_topic" to="/vrpn_client_node/$(arg marker_name)/pose"/>
    <param name="mocap_unit" value="$(arg mocap_unit)" />
    <param name="zero_position_on_first_pose" value="$(arg zero_position_on_first_pose)" />
    <param name="position_offset_x" value="$(arg position_offset_x)" />
    <param name="position_offset_y" value="$(arg position_offset_y)" />
    <param name="position_offset_z" value="$(arg position_offset_z)" />
    <param name="max_abs_position_m" value="$(arg max_abs_position_m)" />
    <param name="local_origin_topic" value="$(arg local_origin_topic)" />
  </node>

  <include file="$(find vrpn_client_ros)/launch/sample.launch">
    <arg name="server" value="$(arg vrpn_server)" />
  </include>
</launch>
