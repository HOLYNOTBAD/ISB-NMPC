<launch>
    <arg name="balloon_motion_file" default="$(find target_register)/config/balloon_motion/balloon_motion_preset_traj_sine_5ms.yaml"/>
    <!-- 0 uses target_num from the YAML file; positive overrides it; -1 uses all. -->
    <arg name="balloon_count" default="0"/>
    <arg name="model_prefix" default="balloon_"/>
    <arg name="world_frame" default="world"/>
    <arg name="uav_model_name" default="holydrone"/>
    <arg name="motion_trigger_topic" default="/fsm/motion_trigger"/>

    <arg name="motion_start_delay_sec" default="0.0"/>
    <arg name="motion_start_min_uav_z" default="0.0"/>
    <arg name="motion_start_use_abs_uav_z" default="false"/>
    <!-- Standalone-launch default; mode launches provide balloon.radius explicitly. -->
    <arg name="balloon_radius" default="1.50"/>
    <arg name="uav_collision_radius" default="0.34"/>
    <arg name="id_marker_text_height" default="10.0"/>
    <arg name="hide_z" default="-5.0"/>

    <arg name="spawn_in_gazebo" default="true"/>
    <arg name="spawn_on_start" default="true"/>
    <arg name="spawn_relative_to_mav" default="false"/>
    <arg name="respawn_models" default="true"/>
    <arg name="auto_advance_on_idle" default="false"/>
    <arg name="fsm_state_topic" default="/fsm/fsm_state"/>
    <arg name="trial_sequence_file" default=""/>
    <arg name="relative_place_min_uav_z" default="0.0"/>
    <arg name="relative_place_use_abs_uav_z" default="false"/>
    <arg name="relative_follow_before_min_z" default="false"/>
    <arg name="keyboard_control" default="false"/>
    <arg name="keyboard_speed" default="1.0"/>

    <arg name="color_r" default="1.0"/>
    <arg name="color_g" default="0.0"/>
    <arg name="color_b" default="0.0"/>
    <arg name="color_a" default="1.0"/>

    <node name="gazebo_balloon_node" pkg="target_register" type="gazebo_balloon_node" output="screen">
        <param name="balloon_motion_file" value="$(arg balloon_motion_file)"/>
        <param name="balloon_count" value="$(arg balloon_count)"/>
        <param name="model_prefix" value="$(arg model_prefix)"/>
        <param name="world_frame" value="$(arg world_frame)"/>
        <param name="uav_model_name" value="$(arg uav_model_name)"/>
        <param name="motion_trigger_topic" value="$(arg motion_trigger_topic)"/>

        <param name="motion_start_delay_sec" value="$(arg motion_start_delay_sec)"/>
        <param name="motion_start_min_uav_z" value="$(arg motion_start_min_uav_z)"/>
        <param name="motion_start_use_abs_uav_z" value="$(arg motion_start_use_abs_uav_z)"/>
        <param name="balloon_radius" value="$(arg balloon_radius)"/>
        <param name="uav_collision_radius" value="$(arg uav_collision_radius)"/>
        <param name="id_marker_text_height" value="$(arg id_marker_text_height)"/>
        <param name="hide_z" value="$(arg hide_z)"/>

        <param name="spawn_in_gazebo" value="$(arg spawn_in_gazebo)"/>
        <param name="spawn_on_start" value="$(arg spawn_on_start)"/>
        <param name="spawn_relative_to_mav" value="$(arg spawn_relative_to_mav)"/>
        <param name="respawn_models" value="$(arg respawn_models)"/>
        <param name="auto_advance_on_idle" value="$(arg auto_advance_on_idle)"/>
        <param name="fsm_state_topic" value="$(arg fsm_state_topic)"/>
        <param name="trial_sequence_file" value="$(arg trial_sequence_file)"/>
        <param name="relative_place_min_uav_z" value="$(arg relative_place_min_uav_z)"/>
        <param name="relative_place_use_abs_uav_z" value="$(arg relative_place_use_abs_uav_z)"/>
        <param name="relative_follow_before_min_z" value="$(arg relative_follow_before_min_z)"/>
        <param name="keyboard_control" value="$(arg keyboard_control)"/>
        <param name="keyboard_speed" value="$(arg keyboard_speed)"/>

        <param name="color_r" value="$(arg color_r)"/>
        <param name="color_g" value="$(arg color_g)"/>
        <param name="color_b" value="$(arg color_b)"/>
        <param name="color_a" value="$(arg color_a)"/>
    </node>
</launch>
